# Trade Threat Intelligence Backend Configuration
# Copy this file to .env and fill in your values

# API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/trade_surveillance
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TRADES=trade_events
KAFKA_TOPIC_ALERTS=suspicious_alerts
KAFKA_CONSUMER_GROUP=trade_surveillance_group

# Integration APIs
JIRA_API_URL=https://your-jira-instance.com
JIRA_API_TOKEN=your_jira_token
JIRA_EMAIL=your_jira_email
JIRA_PROJECT_KEY=COMP

SLACK_WEBHOOK_URL=your_slack_webhook_url
SLACK_CHANNEL=#compliance-alerts

# Application Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Detection Thresholds
LAYERING_CANCEL_RATIO_THRESHOLD=0.8
LAYERING_CANCEL_TIME_THRESHOLD=1000
SPOOFING_ORDER_COUNT_THRESHOLD=10
SPOOFING_CANCEL_RATIO_THRESHOLD=0.7
WASH_TRADING_MATCH_THRESHOLD=0.95
WASH_TRADING_TIME_WINDOW=300
PUMP_DUMP_VOLUME_SPIKE_THRESHOLD=5.0
PUMP_DUMP_PRICE_CHANGE_THRESHOLD=0.05

# Risk Scoring
HIGH_RISK_THRESHOLD=0.8
MEDIUM_RISK_THRESHOLD=0.5
LOW_RISK_THRESHOLD=0.3

# Replay Configuration
REPLAY_SPEED_MULTIPLIER=10.0
REPLAY_BATCH_SIZE=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_TRACKS_STARTED=True
CELERY_TASK_TIME_LIMIT=300
